name = "bvlog-stt"
main = "stt-worker.mjs"
compatibility_date = "2026-10-29"
workers_dev = true

[vars]
ALLOWED_ORIGIN = "https://spasitelenclub.com"
EXPECTED_ISSUER = "https://spasitelenclub.com"

[ai]
binding = "AI"

# Create a KV namespace in Cloudflare and fill in your real ID.
[[kv_namespaces]]
binding = "STT_NONCES"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# Atomic one-use STT ticket reservation. Merge into the site's actual config;
# do not replace real namespace IDs, secrets, issuer or other existing migrations.
[[durable_objects.bindings]]
name = "STT_NONCE_GUARD"
class_name = "STTNonceGuard"

[[migrations]]
tag = "stt-nonce-v1"
new_sqlite_classes = ["STTNonceGuard"]

# Approximate per-user limit, backed by Workers Rate Limiting.
[[ratelimits]]
name = "STT_RATE_LIMIT"
namespace_id = "761842"
  [ratelimits.simple]
  limit = 20
  period = 60

# Add with: npx wrangler secret put GROQ_API_KEY
# Add with: npx wrangler secret put STT_HMAC_SECRET
